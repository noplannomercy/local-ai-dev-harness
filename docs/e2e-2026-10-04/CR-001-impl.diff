package org.springframework.samples.petclinic.service;

import org.mapstruct.Named;
import org.springframework.stereotype.Component;

import java.time.Clock;
import java.time.LocalDate;

/**
 * Single rule for deciding whether a visit is a "recent visit".
 * A visit is recent if its date is between {@link #RECENT_DAYS} days ago and today, both inclusive.
 * Future dates and missing dates are not recent.
 */
@Component
public class VisitRecencyPolicy {

    public static final int RECENT_DAYS = 30;

    private final Clock clock;

    public VisitRecencyPolicy(Clock clock) {
        this.clock = clock;
    }

    @Named("isRecentVisit")
    public boolean isRecent(LocalDate visitDate) {
        if (visitDate == null) {
            return false;
        }
        LocalDate today = LocalDate.now(clock);
        return !visitDate.isAfter(today) && !visitDate.isBefore(today.minusDays(RECENT_DAYS));
    }
}
