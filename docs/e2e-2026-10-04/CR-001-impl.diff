package org.springframework.samples.petclinic.service;

import org.junit.jupiter.api.Test;
import org.springframework.samples.petclinic.config.ClockConfig;

import java.time.Clock;
import java.time.Instant;
import java.time.LocalDate;
import java.time.ZoneId;

import static org.assertj.core.api.Assertions.assertThat;

/**
 * Boundary tests for {@link VisitRecencyPolicy} (CR-001)
 */
class VisitRecencyPolicyTests {

    // 2026-10-04 00:00 in Asia/Seoul
    private static final Clock FIXED = Clock.fixed(Instant.parse("2026-10-03T15:00:00Z"), ClockConfig.CLINIC_ZONE);
    private static final LocalDate TODAY = LocalDate.of(2026, 10, 4);

    private final VisitRecencyPolicy policy = new VisitRecencyPolicy(FIXED);

    @Test
    void todayIsRecent() {
        assertThat(policy.isRecent(TODAY)).isTrue();
    }

    @Test
    void yesterdayIsRecent() {
        assertThat(policy.isRecent(TODAY.minusDays(1))).isTrue();
    }

    @Test
    void exactly30DaysAgoIsRecent() {
        assertThat(policy.isRecent(TODAY.minusDays(30))).isTrue();
    }

    @Test
    void exactly31DaysAgoIsNotRecent() {
        assertThat(policy.isRecent(TODAY.minusDays(31))).isFalse();
    }

    @Test
    void futureDateIsNotRecent() {
        assertThat(policy.isRecent(TODAY.plusDays(1))).isFalse();
    }

    @Test
    void missingDateIsNotRecent() {
        assertThat(policy.isRecent(null)).isFalse();
    }

    @Test
    void todayIsTakenInAsiaSeoulNotUtc() {
        // UTC is still 2026-10-03 at this instant, Seoul is already 2026-10-04
        VisitRecencyPolicy utcPolicy = new VisitRecencyPolicy(FIXED.withZone(ZoneId.of("UTC")));
        assertThat(utcPolicy.isRecent(TODAY)).isFalse();
        // 2026-09-03 is 31 days before Seoul "today" but only 30 days before UTC "today"
        assertThat(policy.isRecent(LocalDate.of(2026, 9, 3))).isFalse();
    }

    @Test
    void monthEndAndLeapYear() {
        VisitRecencyPolicy leap = new VisitRecencyPolicy(
            Clock.fixed(Instant.parse("2028-03-01T03:00:00Z"), ClockConfig.CLINIC_ZONE));
        assertThat(leap.isRecent(LocalDate.of(2028, 1, 31))).isTrue();
        assertThat(leap.isRecent(LocalDate.of(2028, 1, 30))).isFalse();
    }
}
